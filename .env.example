# Unified v1 API surface: https://<resource>.openai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Chat/intent-router deployment (e.g. gpt-5-mini)
AZURE_OPENAI_DEPLOYMENT=
# Phase 8 (Realtime Voice) — speech-to-speech deployment (e.g. gpt-realtime-1.5)
AZURE_OPENAI_REALTIME_DEPLOYMENT=
# Optional: a deployed transcription model, only used to show a live
# transcript of what the caller said. Leave blank if you don't have one.
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=
# "far_field" (default) for a laptop/desk mic, "near_field" for a headset.
REALTIME_NOISE_REDUCTION_MODE=far_field
# 0.0-1.0, higher = requires louder/clearer audio before treating it as
# speech. Raise this if voice keeps triggering on background noise; lower
# it if quieter genuine speech is getting missed. Tune live, no code change.
REALTIME_VAD_THRESHOLD=0.7

TELECOM_API_BASE_URL=https://telecom-poc-andkaxb4hrapgfhw.southafricanorth-01.azurewebsites.net
TELECOM_API_KEY=

INTENT_CONFIDENCE_THRESHOLD=0.80
# Lower bar for the follow-up turn after a clarification (2-3 named candidates).
INTENT_FOLLOWUP_CONFIDENCE_THRESHOLD=0.60

APP_ENV=development
LOG_LEVEL=INFO

CORS_ALLOW_ORIGINS=*
